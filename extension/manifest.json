{
  "manifest_version": 3,
  "name": "Job Hunter Apply Fill",
  "version": "1.1.0",
  "description": "Fill Greenhouse, Lever, Comeet and Workday application forms from your Job Hunter profile. Review before submit.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Hunter Apply"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.comeet.co/*",
        "https://*.comeet.com/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
