# Copy to .env (or run `npm run setup`, which does it for you). Never commit .env.
# Search behaviour (titles, location, threshold, schedule...) is NOT configured here:
# it lives in the app (Preferences) and is set during onboarding.

# --- Database ---
DATABASE_URL=sqlite:///./data/job_hunter.db

# --- Gemini (required) --- https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Aliases track the newest flash model; pinned names can be retired (404 "no longer available").
# List what your key can use:  npm run doctor -- --models
GEMINI_MODEL=gemini-flash-latest
# v1beta has the newest models and -latest aliases (the SDK default may be v1)
GEMINI_API_VERSION=v1beta
EMBEDDING_MODEL=gemini-embedding-001
# Optional pre-filters (run in shadow mode first; see docs/CONFIGURATION.md)
EMBEDDING_FILTER_ENABLED=false
EMBEDDING_SHADOW_MODE=true
EMBEDDING_SIMILARITY_THRESHOLD=0.35
EMBEDDING_RETRIEVE_EXAMPLES=2
GEMMA_MODEL=gemma-4-31b-it
GEMMA_FILTER_ENABLED=false
GEMMA_SHADOW_MODE=true

# --- LinkedIn (optional; guest scraping works without it) ---
LINKEDIN_ENABLED=true
# li_at session cookie for full job descriptions. See docs/LINKEDIN.md. Treat like a password.
LINKEDIN_COOKIE_STRING=
LINKEDIN_ENRICH_MAX=60
LINKEDIN_ENRICH_DELAY_SECONDS=1.5

# --- Sources ---
INDEED_RESULTS_WANTED=100
INGESTION_POOL_SIZE=50
INGESTION_POOL_COUNT=2
INGESTION_POOL_DRYOFF_SECONDS=45
JOBSPY_HOURS_OLD=72
GOOGLE_PLAYWRIGHT_ENABLED=false
GOOGLE_PLAYWRIGHT_HEADLESS=true
GOOGLE_POOL_PAGES=5
GOOGLE_ATS_MAX_PAGES=3
SERP_API_KEY=

# --- Push notifications via ntfy (optional) ---
# Use a long random topic: anyone who knows it can read your alerts. `npm run setup` generates one.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Private tunnel ---
# Generated by `npm run setup`. Required for anything arriving through the tunnel.
ACCESS_TOKEN=
# Skip the token for requests from this machine (localhost). Set false to always require it.
LOCAL_TRUST=true
# link = push full private link, url = push bare URL only, off = terminal only
TUNNEL_NOTIFY_MODE=link

# --- Server ---
# Keep the API on loopback; the tunnel and Vite proxy reach it locally.
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Fallback timezone for the scheduler (the Preferences timezone wins)
CRON_TIMEZONE=UTC
# Set false on a second backend that shares the same DB
INGESTION_ENABLED=true

# --- Apply autofill overrides (optional; otherwise parsed from your CV) ---
APPLY_FULL_NAME=
APPLY_EMAIL=
APPLY_PHONE=
APPLY_LOCATION=
APPLY_LINKEDIN_URL=
APPLY_GITHUB_URL=
APPLY_PORTFOLIO_URL=
